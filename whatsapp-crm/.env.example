# Copia este fichero a .env y expórtalo antes de arrancar, o pasa las
# variables directamente: WHATSAPP_TOKEN=... node server.js
# Sin credenciales, la app funciona en modo demo.

PORT=3000

# Opción A — 360dialog (recomendado para Coexistence; ver COMPARATIVA-BSP.md):
WHATSAPP_360DIALOG_API_KEY=

# Opción B — Meta directo:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0

WEBHOOK_VERIFY_TOKEN=gestoria-crm
