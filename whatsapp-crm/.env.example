# Copia este fichero a .env y expórtalo antes de arrancar, o pasa las
# variables directamente: WHATSAPP_TOKEN=... node server.js
# Sin credenciales, la app funciona en modo demo.

PORT=3000

# Acceso al CRM. Si defines CRM_PASSWORD, la interfaz pide iniciar sesión.
# OBLIGATORIO antes de exponer el CRM en Internet.
CRM_USER=admin
CRM_PASSWORD=

# Opción A — YCloud (API key en Developers > API Keys de la consola de YCloud,
# y el número del negocio en formato internacional, ej. +34612345678):
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=

# Opción B — 360dialog:
WHATSAPP_360DIALOG_API_KEY=

# Opción C — Meta directo:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0

WEBHOOK_VERIFY_TOKEN=gestoria-crm
