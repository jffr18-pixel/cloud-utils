# Copia este archivo a ".env" y rellena los valores.

# Entorno: "production" activa cookies seguras y exige JWT_SECRET.
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Secreto para firmar los tokens de sesión (JWT).
# Genera uno seguro, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Credenciales del administrador inicial (usadas por "npm run seed")
ADMIN_EMAIL=admin@burocraciazero.es
ADMIN_PASSWORD=
